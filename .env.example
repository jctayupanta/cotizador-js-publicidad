# Copia este archivo como .env y completa los valores reales.

# --- Supabase (llegan al frontend: deben llevar el prefijo VITE_) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=tu-clave-publishable

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:tu-token-de-telegram
# ID del chat privado al que el bot enviará los mensajes.
TELEGRAM_CHAT_ID=123456789
# Copias con prefijo VITE_ para que el navegador pueda enviar el aviso.
# OJO: al llevar VITE_, el token queda visible en el JS publicado del sitio.
VITE_TELEGRAM_BOT_TOKEN=123456789:tu-token-de-telegram
VITE_TELEGRAM_CHAT_ID=123456789
